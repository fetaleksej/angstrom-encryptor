{
  "name": "angstrom-encryptor",
  "displayName": "Angstrom Config Encryptor",
  "description": "The encrypter for angtrom configs",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "angstrom-config-encryptor.encrypt",
        "title": "Ang: Encrypt"
      },
      {
        "command": "angstrom-config-encryptor.encryptOldVersion",
        "title": "Ang: Encrypt (old version)"
      }
    ],
    "configuration": {
      "title": "Angstrom encrypter",
      "properties": {
        "angstrom-config-encryptor.keysFilePath": {
          "type": "string",
          "default": "",
          "description": "Full path and name of public key file"
        }, 
        "angstrom-config-encryptor.outputFolderPath": {
          "type": "string",
          "default": "./presets/",
          "description": "Path to the output folder where encrypted \".prst\" files will be stored"
        }
      }
    },
    "keybindings": [
      {
        "command": "angstrom-config-encryptor.encrypt",
        "key": "ctrl+alt+E",
        "mac": "cmd+alt+E",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.76.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.36.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.3.0"
  }, 
  "dependencies": {
    "node-rsa": "^1.0.8"
  }
}
